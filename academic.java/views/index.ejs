<!-- Dashboard Section -->
<section id="dashboard" class="section-content">
  <div class="section-header">
    <h2><i class="fas fa-tachometer-alt"></i> Dashboard Overview</h2>
  </div>
  
  <div class="dashboard-grid">
    <div class="dashboard-card">
      <div class="card-header">
        <i class="fas fa-building"></i>
        <h3>Departments</h3>
      </div>
      <div class="count"><%= data.departments.length %></div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Active</div>
          <div class="value"><%= data.departments.length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.length %></div>
        </div>
      </div>
      <button onclick="showSection('departments')" class="view-all">
        <i class="fas fa-arrow-right"></i> View Details
      </button>
    </div>

    <div class="dashboard-card">
      <div class="card-header">
        <i class="fas fa-graduation-cap"></i>
        <h3>Programs</h3>
      </div>
      <div class="count"><%= data.programs.length %></div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Active</div>
          <div class="value"><%= data.programs.length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Students</div>
          <div class="value"><%= data.students.length %></div>
        </div>
      </div>
      <button onclick="showSection('programs')" class="view-all">
        <i class="fas fa-arrow-right"></i> View Details
      </button>
    </div>

    <div class="dashboard-card">
      <div class="card-header">
        <i class="fas fa-book"></i>
        <h3>Courses</h3>
      </div>
      <div class="count"><%= data.courses.length %></div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Active</div>
          <div class="value"><%= data.courses.length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Students</div>
          <div class="value"><%= data.students.length %></div>
        </div>
      </div>
      <button onclick="showSection('courses')" class="view-all">
        <i class="fas fa-arrow-right"></i> View Details
      </button>
    </div>

    <div class="dashboard-card">
      <div class="card-header">
        <i class="fas fa-user-graduate"></i>
        <h3>Students</h3>
      </div>
      <div class="count"><%= data.students.length %></div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Total</div>
          <div class="value"><%= data.students.length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.length %></div>
        </div>
      </div>
      <button onclick="showSection('students')" class="view-all">
        <i class="fas fa-arrow-right"></i> View Details
      </button>
    </div>

    <div class="dashboard-card">
      <div class="card-header">
        <i class="fas fa-chalkboard-teacher"></i>
        <h3>Faculty</h3>
      </div>
      <div class="count"><%= data.faculty.length %></div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Total</div>
          <div class="value"><%= data.faculty.length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Departments</div>
          <div class="value"><%= data.departments.length %></div>
        </div>
      </div>
      <button onclick="showSection('faculty')" class="view-all">
        <i class="fas fa-arrow-right"></i> View Details
      </button>
    </div>
  </div>
</section>

<!-- Departments Section -->
<section id="departments" class="section-content" style="display: none;">
  <div class="section-header">
    <h2><i class="fas fa-building"></i> Departments</h2>
  </div>
  <div class="cards-grid">
    <% if (data.departments.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-building"></i>
        <p>No departments added yet. Add your first department!</p>
      </div>
    <% } %>
    <% data.departments.forEach(dept => { %>
      <div class="card" id="department-<%= dept.id %>">
        <div class="content">
          <div class="card-header">
            <i class="fas fa-building"></i>
            <h3><%= dept.name %></h3>
          </div>
          <div class="card-stats">
            <div class="stat-item">
              <div class="label">Programs</div>
              <div class="value"><%= data.programs.filter(p => p.departmentId === dept.id).length || 0 %></div>
            </div>
            <div class="stat-item">
              <div class="label">Faculty</div>
              <div class="value"><%= data.faculty.filter(f => f.departmentId === dept.id).length || 0 %></div>
            </div>
          </div>
          <div class="card-actions">
            <button class="edit-btn" data-id="<%= dept.id %>" data-name="<%= dept.name %>" data-type="department" onclick="showEditForm(this.dataset.id, this.dataset.name, this.dataset.type)">
              <i class="fas fa-edit"></i> Edit
            </button>
            <form action="/departments/<%= dept.id %>/delete" method="post" style="display: inline;">
              <button type="submit" class="delete-btn">
                <i class="fas fa-trash"></i> Delete
              </button>
            </form>
          </div>
        </div>
        <form action="/departments/<%= dept.id %>/edit" method="post" class="edit-form" style="display: none;">
          <div class="form-group">
            <input type="text" name="name" value="<%= dept.name %>" required placeholder="Department Name">
          </div>
          <div class="form-actions">
            <button type="submit" class="save-btn">
              <i class="fas fa-check"></i> Save
            </button>
            <button type="button" class="cancel-btn" data-id="<%= dept.id %>" data-type="department" onclick="hideEditForm(this.dataset.id, this.dataset.type)">
              <i class="fas fa-times"></i> Cancel
            </button>
          </div>
        </form>
      </div>
    <% }) %>
    <div class="add-card">
      <div class="card">
        <form action="/departments" method="post">
          <div class="form-group">
            <input type="text" name="name" placeholder="New Department Name" required>
          </div>
          <div class="form-actions">
            <button type="submit" class="save-btn">
              <i class="fas fa-plus"></i> Add Department
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

