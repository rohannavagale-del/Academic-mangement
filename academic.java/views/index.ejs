<!-- Dashboard Section -->
<section id="dashboard" class="section-content">
  <div class="section-header">
    <h2><i class="fas fa-tachometer-alt"></i> Dashboard Overview</h2>
  </div>
  
  <div class="dashboard-grid">
    <!-- Basic Tier Card -->
    <div class="card basic">
      <div class="tier-badge">Basic Tier</div>
      <div class="card-header">
        <i class="fas fa-cube"></i>
        <h3>Basic Services</h3>
      </div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Departments</div>
          <div class="value"><%= data.departments.filter(d => d.tier === 'basic').length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.filter(p => p.tier === 'basic').length %></div>
        </div>
        <div class="stat-item delivery-time">
          <div class="label"><i class="fas fa-clock"></i> Delivery Time</div>
          <div class="value">5-7 business days</div>
        </div>
      </div>
    </div>

    <!-- Pro Tier Card -->
    <div class="card pro">
      <div class="tier-badge">Pro Tier</div>
      <div class="card-header">
        <i class="fas fa-star"></i>
        <h3>Pro Services</h3>
      </div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Departments</div>
          <div class="value"><%= data.departments.filter(d => d.tier === 'pro').length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.filter(p => p.tier === 'pro').length %></div>
        </div>
        <div class="stat-item delivery-time">
          <div class="label"><i class="fas fa-clock"></i> Delivery Time</div>
          <div class="value">2-3 business days</div>
        </div>
      </div>
    </div>

    <!-- Premium Tier Card -->
    <div class="card premium">
      <div class="tier-badge">Premium Tier</div>
      <div class="card-header">
        <i class="fas fa-crown"></i>
        <h3>Premium Services</h3>
      </div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Departments</div>
          <div class="value"><%= data.departments.filter(d => d.tier === 'premium').length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.filter(p => p.tier === 'premium').length %></div>
        </div>
        <div class="stat-item delivery-time">
          <div class="label"><i class="fas fa-clock"></i> Delivery Time</div>
          <div class="value">24 hours</div>
        </div>
      </div>
    </div>
    <!-- Basic Tier Section -->
    <div class="dashboard-card basic">
      <div class="tier-badge basic">Basic Tier</div>
      <div class="card-header">
        <i class="fas fa-cube"></i>
        <h3>Basic Services</h3>
      </div>
      <div class="count">
        <%= data.departments.filter(d => d.tier === 'basic').length + 
            data.programs.filter(p => p.tier === 'basic').length %>
      </div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Departments</div>
          <div class="value"><%= data.departments.filter(d => d.tier === 'basic').length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.filter(p => p.tier === 'basic').length %></div>
        </div>
      </div>
    </div>

    <!-- Pro Tier Section -->
    <div class="dashboard-card pro">
      <div class="tier-badge pro">Pro Tier</div>
      <div class="card-header">
        <i class="fas fa-star"></i>
        <h3>Pro Services</h3>
      </div>
      <div class="count">
        <%= data.departments.filter(d => d.tier === 'pro').length + 
            data.programs.filter(p => p.tier === 'pro').length %>
      </div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Departments</div>
          <div class="value"><%= data.departments.filter(d => d.tier === 'pro').length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.filter(p => p.tier === 'pro').length %></div>
        </div>
      </div>
    </div>

    <!-- Premium Tier Section -->
    <div class="dashboard-card premium">
      <div class="tier-badge premium">Premium Tier</div>
      <div class="card-header">
        <i class="fas fa-crown"></i>
        <h3>Premium Services</h3>
      </div>
      <div class="count">
        <%= data.departments.filter(d => d.tier === 'premium').length + 
            data.programs.filter(p => p.tier === 'premium').length %>
      </div>
      <div class="card-stats">
        <div class="stat-item">
          <div class="label">Departments</div>
          <div class="value"><%= data.departments.filter(d => d.tier === 'premium').length %></div>
        </div>
        <div class="stat-item">
          <div class="label">Programs</div>
          <div class="value"><%= data.programs.filter(p => p.tier === 'premium').length %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Departments Section -->
<section id="departments" class="section-content" style="display: none;">
  <div class="section-header">
    <h2><i class="fas fa-building"></i> Departments</h2>
  </div>
  <div class="cards-grid">
    <% if (data.departments.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-building"></i>
        <p>No departments added yet. Add your first department!</p>
      </div>
    <% } %>
    <% data.departments.forEach(dept => { %>
      <div class="card <%= dept.tier %>" id="department-<%= dept.id %>" data-tier="<%= dept.tier %>">
        <div class="content">
          <div class="card-header">
            <i class="fas fa-building"></i>
            <h3><%= dept.name %></h3>
          </div>
          <div class="tier-badge <%= dept.tier %>"><%= dept.tier.charAt(0).toUpperCase() + dept.tier.slice(1) %></div>
          <div class="card-stats">
            <div class="stat-item">
              <div class="label">Programs</div>
              <div class="value"><%= data.programs.filter(p => p.departmentId === dept.id).length || 0 %></div>
            </div>
            <div class="stat-item">
              <div class="label">Faculty</div>
              <div class="value"><%= data.faculty.filter(f => f.departmentId === dept.id).length || 0 %></div>
            </div>
          </div>
          <div class="card-actions">
            <button class="edit-btn" onclick="showEditForm('<%= dept.id %>', 'department')">
              <i class="fas fa-edit"></i> Edit
            </button>
            <form action="/departments/<%= dept.id %>/delete" method="post" style="display: inline;">
              <button type="submit" class="delete-btn">
                <i class="fas fa-trash"></i> Delete
              </button>
            </form>
          </div>
        </div>
        <form action="/departments/<%= dept.id %>/edit" method="post" class="edit-form" style="display: none;">
          <div class="form-group">
            <input type="text" name="name" value="<%= dept.name %>" required placeholder="Department Name">
          </div>
          <div class="form-group">
            <select name="tier" required>
              <option value="">Select Tier</option>
              <option value="basic" <%= dept.tier === 'basic' ? 'selected' : '' %>>Basic (Brown)</option>
              <option value="pro" <%= dept.tier === 'pro' ? 'selected' : '' %>>Pro (Silver)</option>
              <option value="premium" <%= dept.tier === 'premium' ? 'selected' : '' %>>Premium (Gold)</option>
            </select>
          </div>
          <div class="form-actions">
            <button type="submit" class="save-btn">
              <i class="fas fa-save"></i> Save
            </button>
            <button type="button" class="cancel-btn" onclick="hideEditForm('<%= dept.id %>', 'department')">
              <i class="fas fa-times"></i> Cancel
            </button>
          </div>
        </form>
      </div>
    <% }) %>
    <div class="add-card">
      <div class="card">
        <form action="/departments" method="post">
          <div class="form-group">
            <input type="text" name="name" placeholder="New Department Name" required>
          </div>
          <div class="form-group">
            <select name="tier" required>
              <option value="">Select Tier</option>
              <option value="basic">Basic (Brown)</option>
              <option value="pro">Pro (Silver)</option>
              <option value="premium">Premium (Gold)</option>
            </select>
          </div>
          <div class="form-actions">
            <button type="submit" class="save-btn">
              <i class="fas fa-plus"></i> Add Department
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
function showSection(sectionId) {
  document.querySelectorAll('.section-content').forEach(section => {
    section.style.display = 'none';
  });
  document.getElementById(sectionId).style.display = 'block';
}

function showEditForm(id, type) {
  const card = document.getElementById(`${type}-${id}`);
  if (card) {
    card.querySelector('.content').style.display = 'none';
    card.querySelector('.edit-form').style.display = 'block';
  }
}

function hideEditForm(id, type) {
  const card = document.getElementById(`${type}-${id}`);
  if (card) {
    card.querySelector('.content').style.display = 'block';
    card.querySelector('.edit-form').style.display = 'none';
  }
}

// Show initial section
window.addEventListener('load', () => {
  const hash = window.location.hash.slice(1) || 'dashboard';
  showSection(hash);
});
</script>
